# Get a key at https://app.nansen.ai/api
NANSEN_API_KEY=
# Port for the local web app
PORT=3000
# Training hands are judged on the whale's real exit, capped at this many hours
MAX_HOLD_HOURS=72
# How many resolved Smart Money trades the hourly odds calibration trains on
CALIBRATION_SAMPLE=60
# Set to 1 to run with demo data (no Nansen key needed; prices are still real Hyperliquid prices)
DEMO=0
# Cap on stored players (never-played visitors are pruned first when it is reached)
MAX_PLAYERS=100000
# Local development only: lets the alert settings page open without an admin token.
# NEVER set this on a hosted deploy - use ADMIN_TOKEN there instead.
# DEV_OPEN_ADMIN=1
